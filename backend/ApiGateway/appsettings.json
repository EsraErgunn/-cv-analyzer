{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "upload-route": {
        "ClusterId": "upload-cluster",
        "RateLimiterPolicy": "upload",
        "Match": { "Path": "/api/upload/{**catch-all}" }
      },
      "results-route": {
        "ClusterId": "result-cluster",
        "Match": { "Path": "/api/results/{**catch-all}" }
      }
    },
    "Clusters": {
      "upload-cluster": {
        "Destinations": {
          "upload": { "Address": "http://localhost:5264" }
        }
      },
      "result-cluster": {
        "Destinations": {
          "result": { "Address": "http://localhost:5175" }
        }
      }
    }
  }
}
